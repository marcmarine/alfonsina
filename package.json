{
  "name": "alfonsina",
  "version": "0.0.0",
  "description": "Astrology calculation library for JavaScript and TypeScript, built on swappable ephemeris engines.",
  "type": "module",
  "license": "MIT",
  "author": "Marc Mariné",
  "keywords": [
    "astrology",
    "astronomy",
    "ephemeris",
    "horoscope",
    "natal-chart",
    "houses",
    "aspects"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
