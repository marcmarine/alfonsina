{
  "name": "alfonsina",
  "version": "0.0.0",
  "description": "Astrology calculation library for JavaScript and TypeScript, built on swappable ephemeris engines.",
  "type": "module",
  "license": "MIT",
  "author": "Marc Mariné",
  "keywords": [
    "astrology",
    "astronomy",
    "ephemeris",
    "horoscope",
    "natal-chart",
    "houses",
    "aspects"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./engines/caelus": {
      "types": "./dist/engines/caelus/index.d.ts",
      "import": "./dist/engines/caelus/index.js"
    },
    "./engines/naelos": {
      "types": "./dist/engines/naelos/index.d.ts",
      "import": "./dist/engines/naelos/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "bench": "vitest bench --run --reporter=verbose",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "update-delta-t": "bun scripts/update-delta-t.ts && biome format --write src/core/time/delta-t-data.ts",
    "fetch-horizons": "bun scripts/fetch-horizons.ts && biome format --write tests/reference-data/horizons.json"
  },
  "peerDependencies": {
    "caelus": "^0.25.0",
    "naelos-ephemeris": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "caelus": {
      "optional": true
    },
    "naelos-ephemeris": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "caelus": "0.25.0",
    "naelos-ephemeris": "0.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
